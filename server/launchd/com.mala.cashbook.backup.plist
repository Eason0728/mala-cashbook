<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 麻的小辛辣｜現金收支登記 — 每日備份（server/backup.js）：每天 03:50（系統時區須為台北）。
     StartCalendarInterval 錯過的班（睡眠／關機）會在喚醒後補跑；/cashbook/health 在上次成功備份超過 26 小時時轉紅。
     範本佔位字串同 com.mala.cashbook.plist；BACKUP_URL／BACKUP_KEY 放 __REPO__/server/.env（沒設時 backup.js 記失敗、/health 會紅燈）。
     錯開貨單的 03:40，避免兩支同時打 Apps Script。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mala.cashbook.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/server/backup.js</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATA_DIR</key><string>__DATA_DIR__</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>50</integer>
  </dict>
  <key>StandardOutPath</key><string>__DATA_DIR__/logs/backup.out.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/logs/backup.err.log</string>
</dict>
</plist>
