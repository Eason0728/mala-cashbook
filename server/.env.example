# 複製成 server/.env 再填值（server/.env 已 gitignore，絕不 commit）
# 監聽埠（預設 8795）
PORT=
# 綁定位址（預設 127.0.0.1，Funnel 由本機轉進來）
BIND=
# 資料目錄（預設 ~/mala-cashbook-data）
DATA_DIR=
# 管理通行碼初始值（只在資料庫還沒有管理碼時寫入一次，之後在設定頁改）
ADMIN_INIT=
# 損益系統 pnlSummary 專用金鑰（與通行碼無關）
PNL_KEY=
# 備份 Apps Script 網址（dzy 帳號部署的 /exec）
BACKUP_URL=
# 備份金鑰（要與備份 Apps Script 的 BACKUP_KEY 相同）
BACKUP_KEY=
# 額外允許的前端來源，逗號分隔（預設已含 https://eason0728.github.io）
ALLOW_ORIGIN=
# 照片網址前綴，必填，例 https://<mini>.ts.net/cashbook（空值 server 不啟動）
PUBLIC_BASE=
# 設 1 時 access log 多記 xff 段數（只記段數不記 IP），用來實測 Funnel 有沒有送 X-Forwarded-For
LOG_XFF=
